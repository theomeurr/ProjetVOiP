// =============================================================================
// Modèle de configuration de production de l'annuaire.
// Copier ce fichier en « appsettings.Production.json » sur le serveur (jamais dans le dépôt :
// ce nom est exclu par .gitignore), puis compléter les valeurs.
//
// Chaque valeur peut aussi être fournie par variable d'environnement, en remplaçant « : » par « __ » :
//   Ldap__BindPassword, Calling__Yealink__Password…
// Recommandé pour les mots de passe (variables définies sur le pool d'applications IIS).
// =============================================================================
{
  "Directory": {
    // "Ldap" en production. "Mock" (agents fictifs) est refusé en production.
    "Provider": "Ldap",
    // Durée du cache de l'annuaire en minutes (une modification dans l'AD apparaît au plus tard après ce délai).
    "CacheMinutes": 15
  },

  "Ldap": {
    // Nom DNS complet du contrôleur de domaine : il doit correspondre au certificat LDAPS.
    "Server": "dc01.montmagny.local",
    "Port": 636,
    "UseSsl": true,
    // Compte de service en LECTURE SEULE (simple utilisateur du domaine, sans droit particulier).
    "BindUser": "svc-annuaire@montmagny.local",
    "BindPassword": "<à renseigner, ou variable d'environnement Ldap__BindPassword>",
    "BaseDn": "DC=montmagny,DC=local",
    // OU où chercher les agents. Vide = tout BaseDn.
    "IncludeOus": [
      "OU=Agents,DC=montmagny,DC=local"
    ],
    // OU à ignorer (et leurs sous-OU) : comptes techniques, comptes de test…
    "ExcludeOus": [
      "OU=Comptes techniques,OU=Agents,DC=montmagny,DC=local"
    ],
    // Filtre par défaut : personnes dont le compte n'est pas désactivé.
    "UserFilter": "(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))",
    // OU des objets « contact » non nominatifs (Accueil, CNI/Passeport, Bureau des élus…). Vide = aucun.
    "ContactsOu": "OU=Annuaire - Services,DC=montmagny,DC=local",
    "ContactFilter": "(objectClass=contact)",
    // Attribut AD contenant l'adresse IP du téléphone de chaque agent.
    "PhoneIpAttribute": "extensionAttribute1",
    "LoadPhotos": true,
    "TimeoutSeconds": 15,
    "PageSize": 500
  },

  "Display": {
    "OrganizationName": "Ville de Montmagny",
    "ContactsSectionTitle": "Accueil du public",
    "ShowMobile": true,
    // Si non vide, le mobile n'est affiché que pour ces services (valeurs exactes de « department »).
    "MobileDepartments": []
  },

  "Calling": {
    // Disabled | YealinkActionUri | GenericHttp | TelLink
    "Provider": "Disabled",
    "TimeoutSeconds": 5,
    // Sous-réseau(x) des téléphones (VLAN VoIP), ex. [ "10.20.0.0/16" ].
    // Le serveur ne contacte jamais une IP hors de ces réseaux (repli sur un lien tel:).
    // Vide = pas de restriction : à renseigner dès que le plan d'adressage VoIP est connu.
    "AllowedPhoneSubnets": [],
    // Nombre maximal d'appels par minute et par agent. 0 = pas de limite.
    "MaxCallsPerMinute": 0,

    "Yealink": {
      // Variables : {callerIp}, {callerExt}, {number}.
      "UrlTemplate": "https://{callerIp}/servlet?key=number={number}",
      "Username": "admin",
      "Password": "<à renseigner, ou variable d'environnement Calling__Yealink__Password>",
      "AcceptInvalidCertificate": true
    },

    // Exemple pour une API d'IPBX. Variables : {callerExt}, {callerIp}, {number}.
    "GenericHttp": {
      "Method": "POST",
      "UrlTemplate": "https://ipbx.montmagny.local/api/click2call",
      "BodyTemplate": "{\"from\":\"{callerExt}\",\"to\":\"{number}\"}",
      "ContentType": "application/json",
      "Headers": {
        "Authorization": "Bearer <jeton API de l'IPBX>"
      },
      "Username": "",
      "Password": "",
      "AcceptInvalidCertificate": false
    },

    "TelLink": {
      // "tel" ou "sip" ; pour sip, domaine optionnel (sip:numero@domaine).
      "Scheme": "tel",
      "SipDomain": ""
    }
  },

  "Numbering": {
    // Postes internes : 4 chiffres, composés tels quels.
    "InternalExtensionLength": 4,
    // Préfixe de prise de ligne extérieure. "" si l'IPBX n'en demande pas.
    "OutsideLinePrefix": "0",
    // SDA de la mairie (01 34 28 XX XX) : converties en poste interne au lieu de sortir sur le réseau public.
    "InternalSdaPrefixes": [ "013428" ],
    "CountryCode": "33",
    "InternationalPrefix": "00"
  },

  "FileLogging": {
    // Dossier des journaux : le compte du pool d'applications doit pouvoir y écrire.
    "Directory": "D:\\Logs\\Annuaire",
    // Journal des appels (appels-AAAAMMJJ.log) : 1 an.
    "CallLogRetentionDays": 365,
    // Journal technique (annuaire-AAAAMMJJ.log).
    "AppLogRetentionDays": 90
  }
}
