{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Directory": {
    "Provider": "Ldap",
    "CacheMinutes": 15,
    "MockFile": "Data/mock-directory.json"
  },

  "Ldap": {
    "Server": "",
    "Port": 636,
    "UseSsl": true,
    "BindUser": "",
    "BindPassword": "",
    "BaseDn": "",
    "IncludeOus": [],
    "ExcludeOus": [],
    "UserFilter": "(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))",
    "ContactsOu": "",
    "ContactFilter": "(objectClass=contact)",
    "PhoneIpAttribute": "extensionAttribute1",
    "LoadPhotos": true,
    "TimeoutSeconds": 15,
    "PageSize": 500
  },

  "Display": {
    "OrganizationName": "Ville de Montmagny",
    "ContactsSectionTitle": "Accueil du public",
    "ShowMobile": true,
    "MobileDepartments": []
  }
}
