{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Directory": {
    "Provider": "Ldap",
    "CacheMinutes": 15,
    "MockFile": "Data/mock-directory.json"
  },
  "Ldap": {
    "Server": "",
    "Port": 636,
    "UseSsl": true,
    "BindUser": "",
    "BindPassword": "",
    "BaseDn": "",
    "IncludeOus": [],
    "ExcludeOus": [],
    "UserFilter": "(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))",
    "ContactsOu": "",
    "ContactFilter": "(objectClass=contact)",
    "PhoneIpAttribute": "extensionAttribute1",
    "LoadPhotos": true,
    "TimeoutSeconds": 15,
    "PageSize": 500
  },
  "Display": {
    "OrganizationName": "Ville de Montmagny",
    "ContactsSectionTitle": "Accueil du public",
    "ShowMobile": true,
    "MobileDepartments": []
  },
  "Calling": {
    "Provider": "Disabled",
    "TimeoutSeconds": 5,
    "AllowedPhoneSubnets": [],
    "Yealink": {
      "UrlTemplate": "https://{callerIp}/servlet?key=number={number}",
      "Username": "",
      "Password": "",
      "AcceptInvalidCertificate": true
    },
    "GenericHttp": {
      "Method": "GET",
      "UrlTemplate": "",
      "BodyTemplate": "",
      "ContentType": "application/json",
      "Headers": {},
      "Username": "",
      "Password": "",
      "AcceptInvalidCertificate": false
    },
    "TelLink": {
      "Scheme": "tel",
      "SipDomain": ""
    }
  },
  "Numbering": {
    "InternalExtensionLength": 4,
    "OutsideLinePrefix": "0",
    "InternalSdaPrefixes": [
      "013428"
    ],
    "CountryCode": "33",
    "InternationalPrefix": "00"
  }
}