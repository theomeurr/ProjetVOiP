@page
@model ErrorModel
@{
    ViewData["Title"] = "Erreur";
}

<header class="masthead">
    <div class="wrap">
        <a class="brand" href="@Url.Content("~/")">
            <span class="brand-title">Annuaire</span>
        </a>
    </div>
</header>
<main class="wrap">
    <div class="empty" role="alert">
        <p class="empty-title">Une erreur est survenue</p>
        <p>L'annuaire n'a pas pu afficher cette page. Réessayez dans quelques instants ; si le problème persiste, contactez la DSI.</p>
        @if (Model.ShowRequestId)
        {
            <p>Référence à communiquer : <strong>@Model.RequestId</strong></p>
        }
    </div>
</main>
